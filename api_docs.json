        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_documents_api_v1_datasets__dataset_id__documents_post"
      },
      "ChatCreateRequest": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "聊天名称"
          },
          "dataset_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Dataset Ids",
            "description": "关联的数据集ID列表",
            "default": []
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description",
            "description": "聊天描述"
          },
          "llm_config": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Llm Config",
            "default": {
              "model_name": "deepseek-chat",
              "temperature": 0.7,
              "max_tokens": 2000
            }
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "ChatCreateRequest"
      },
      "ChatMessageRequest": {
        "properties": {
          "content": {
            "type": "string",
            "title": "Content",
            "description": "消息内容"
          },
          "stream": {
            "type": "boolean",
            "title": "Stream",
            "description": "是否流式返回",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "content"
        ],
        "title": "ChatMessageRequest"
      },
      "DatasetCreateRequest": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "embedding_model": {
            "type": "string",
            "title": "Embedding Model",
            "default": "BAAI/bge-m3@SILICONFLOW"
          },
          "chunk_method": {
            "type": "string",
            "title": "Chunk Method",
            "default": "naive"
          },
          "parser_config": {
            "additionalProperties": true,
            "type": "object",
            "title": "Parser Config",
            "default": {
              "chunk_token_num": 512,
              "delimiter": "\\n"
            }
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "DatasetCreateRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RetrievalRequest": {
        "properties": {
          "question": {
            "type": "string",
            "title": "Question",
            "description": "检索问题"
          },
          "dataset_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Dataset Ids",
            "description": "要检索的数据集ID列表"
          },
          "page": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page",
            "default": 1
          },
          "page_size": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Page Size",
            "default": 5
          },
          "similarity_threshold": {
            "type": "number",
            "title": "Similarity Threshold",
            "default": 0.1
          }
        },
        "type": "object",
        "required": [
          "question",
          "dataset_ids"
        ],
        "title": "RetrievalRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
