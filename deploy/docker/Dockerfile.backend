# Multi-stage build for xDAN RAG Copilot API Backend
FROM python:3.11-slim as builder

# 设置工作目录
WORKDIR /app

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 复制requirements文件
COPY requirements.txt* ./

# 创建requirements.txt如果不存在
RUN if [ ! -f requirements.txt ]; then \
    echo "fastapi==0.115.13" > requirements.txt && \
    echo "uvicorn==0.34.3" >> requirements.txt && \
    echo "python-multipart==0.0.20" >> requirements.txt && \
    echo "requests==2.32.4" >> requirements.txt && \
    echo "pydantic==2.11.7" >> requirements.txt && \
    echo "redis==5.0.1" >> requirements.txt && \
    echo "psycopg2-binary==2.9.9" >> requirements.txt; \
    fi

# 安装Python依赖
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Production stage
FROM python:3.11-slim

# 设置环境变量
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8050 \
    HOST=0.0.0.0

# 创建非root用户
RUN groupadd -r xdan && useradd -r -g xdan xdan

# 安装运行时依赖
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 设置工作目录
WORKDIR /app

# 从builder阶段复制Python包
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# 复制应用代码
COPY xdan_api_proxy_server_fixed.py ./
COPY deploy/docker/.env.docker ./.env

# 创建日志目录
RUN mkdir -p /app/logs && chown -R xdan:xdan /app

# 切换到非root用户
USER xdan

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:${PORT}/health || exit 1

# 暴露端口
EXPOSE ${PORT}

# 启动命令
CMD ["python", "xdan_api_proxy_server_fixed.py"]