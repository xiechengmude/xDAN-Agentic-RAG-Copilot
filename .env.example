# RAGFlow API 配置
RAGFLOW_API_URL=http://your-ragflow-server:7080
RAGFLOW_API_KEY=your-api-key-here

# S3框架模型配置
# Search Model - 用于S3框架中的搜索决策
S3_SEARCH_MODEL_NAME=your-search-model-name
S3_SEARCH_MODEL_URL=http://your-search-llm-server:8000/v1
S3_SEARCH_MODEL_API_KEY=your-search-model-api-key

# Generator Model - 用于最终答案生成
S3_GENERATOR_MODEL_NAME=your-generator-model-name
S3_GENERATOR_API_BASE=http://your-generator-llm-server:8000/v1
S3_GENERATOR_API_KEY=your-generator-model-api-key

# 默认数据集ID（可选）
DEFAULT_DATASET_ID=your-dataset-id

# 服务器配置
HOST=0.0.0.0
PORT=8000
EOF < /dev/null