# FlashSearch 测试环境配置
# 注意: 这是测试配置，生产环境请使用真实的API密钥

# 必需的API密钥 (请替换为真实密钥)
BRIGHTDATA_API_KEY=test_brightdata_key
FIRECRAWL_API_KEY=test_firecrawl_key  
DEEPSEEK_API_KEY=test_deepseek_key

# LiteLLM配置
LITELLM_MODEL=deepseek-chat
LITELLM_API_BASE=https://api.deepseek.com

# Langfuse配置 (可选)
LANGFUSE_SECRET_KEY=test_langfuse_secret
LANGFUSE_PUBLIC_KEY=test_langfuse_public
LANGFUSE_HOST=https://cloud.langfuse.com

# 服务器配置
API_PORT=8000
MCP_PORT=9000

# 日志配置
LOG_LEVEL=info