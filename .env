# Agentic-RAG-Service 环境配置示例
# 复制此文件为 .env 并填入实际配置

# ==================== RAGFlow 配置 ====================
# RAGFlow API地址（检索服务）
RAGFLOW_API_URL=http://150.109.16.195:7080

# RAGFlow API密钥（必需）
RAGFLOW_API_KEY=your-ragflow-api-key

# 默认数据集ID
DEFAULT_DATASET_ID=7e8d9e924cde11f0afc90242ac140006

# ==================== LiteLLM 配置 ====================
# LiteLLM API地址（生成服务）
LITELLM_API_URL=http://localhost:4000

# LiteLLM API密钥
LITELLM_API_KEY=sk-ragflow-integration-key

# ==================== LLM 提供商配置 ====================
# OpenAI API密钥（可选，用于LiteLLM）
OPENAI_API_KEY=sk-your-openai-key

# Anthropic API密钥（可选）
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# DeepSeek API密钥（可选，成本较低）
DEEPSEEK_API_KEY=sk-your-deepseek-key

# Gemini API密钥（可选）
GEMINI_API_KEY=your-gemini-key

# ==================== 模型配置 ====================
# 默认生成模型
DEFAULT_MODEL=gpt-4o-mini

# 智能体推理模型（用于S3框架Select阶段）
AGENT_MODEL=gpt-4o-mini

# 答案生成模型（用于S3框架Synthesize阶段）
GENERATION_MODEL=gpt-4o-mini

# 备用模型列表（逗号分隔）
FALLBACK_MODELS=gpt-3.5-turbo,claude-3-haiku,deepseek-chat

# ==================== 服务端口配置 ====================
# Agentic RAG服务端口
RAG_SERVICE_PORT=8001

# RAGFlow检索服务端口
RETRIEVAL_SERVER_PORT=8060

# LiteLLM服务端口
LITELLM_PORT=4000

# ==================== S3框架配置 ====================
# 最大搜索轮数
MAX_SEARCH_ROUNDS=3

# 默认检索数量
DEFAULT_TOP_K=10

# 相似度阈值
SIMILARITY_THRESHOLD=0.1

# 生成温度（智能体推理使用较低温度）
AGENT_TEMPERATURE=0.1

# 答案生成温度
GENERATION_TEMPERATURE=0.7

# 最大生成token数
MAX_TOKENS=2000

# 智能体推理最大token数
AGENT_MAX_TOKENS=1000

# ==================== 日志配置 ====================
# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 是否启用详细日志
VERBOSE_LOGGING=false

# ==================== LiteLLM路由配置 ====================
# 是否启用智能路由
ENABLE_ROUTING=true

# 路由策略（cost-based, latency-based, usage-based）
ROUTING_STRATEGY=cost-based

# 重试次数
RETRY_COUNT=3

# ==================== 客户端认证 ====================
# 允许的API密钥（用于客户端认证）
CLIENT_API_KEY=xdan-key-001

# ==================== Langfuse配置 ====================
# Langfuse项目密钥
LANGFUSE_PUBLIC_KEY=pk-lf-a9584006-ab4a-4301-a1a1-691eb6f0377a
LANGFUSE_SECRET_KEY=sk-lf-e3aec777-8820-480f-95aa-37498c76cbe4

# Langfuse主机地址（本地实例）
LANGFUSE_HOST=http://localhost:3000

# 可选：调试模式
LANGFUSE_DEBUG=true

# ==================== 搜索引擎配置 ====================
# BrightData API密钥（用于SERP搜索）
BRIGHTDATA_API_KEY=7f43b8faf2b1e3ccb9c6982c443d9138edc76fb0384bdc551d9ca2da5576ee4a
BRIGHTDATA_API_ENDPOINT=https://api.brightdata.com/request
BRIGHTDATA_ZONE=xdan_search_searp
BRIGHTDATA_FORMAT=raw
BRIGHTDATA_TIMEOUT=60

# FireCrawl API密钥（用于网页爬取）
FIRECRAWL_API_KEY=fc-87533b34d5834363b71adc2d3870da92